[Unit]
Description=Investigate one incident from the durable queue
Wants=hermes-lab-runtime.service network-online.target
After=hermes-lab-runtime.service network-online.target
PartOf=hermes-lab.target
ConditionPathExists=/srv/hermes-lab/ops/enabled

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
UMask=0077
WorkingDirectory=/srv/hermes-lab/code
ExecStart=/usr/bin/python3.14 -m investigator.runtime.investigation_worker --config /etc/hermes-lab/executor.json --findings /srv/hermes-lab/findings
TimeoutStartSec=330
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
