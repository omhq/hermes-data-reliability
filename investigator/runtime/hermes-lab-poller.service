[Unit]
Description=Collect configured CloudWatch log matches into the incident database
Wants=network-online.target
After=network-online.target
PartOf=hermes-lab.target
ConditionPathExists=/srv/hermes-lab/ops/enabled

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
UMask=0077
Environment=AWS_DEFAULT_REGION=us-east-1
WorkingDirectory=/srv/hermes-lab/code
ExecStart=/srv/hermes-lab/collector-venv-py314/bin/python -m collector.poll --config /etc/hermes-lab/executor.json --observations /srv/hermes-lab/observations.yaml --findings /srv/hermes-lab/findings
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true

