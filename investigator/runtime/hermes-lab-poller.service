[Unit]
Description=Collect configured CloudWatch log matches and investigate with Hermes
After=hermes-lab-runtime.service network-online.target
Requires=hermes-lab-runtime.service
PartOf=hermes-lab.target
ConditionPathExists=/srv/hermes-lab/ops/enabled

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
UMask=0077
Environment=AWS_DEFAULT_REGION=us-east-1
WorkingDirectory=/srv/hermes-lab/code
ExecStart=/srv/hermes-lab/collector-venv-py314/bin/python -m investigator.collector.poll --config /etc/hermes-lab/executor.json --observations /srv/hermes-lab/observations.yaml --findings /srv/hermes-lab/findings
TimeoutStartSec=390
NoNewPrivileges=true
PrivateTmp=true

