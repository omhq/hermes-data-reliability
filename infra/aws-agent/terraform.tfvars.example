aws_profile         = "YOUR_PROFILE"
aws_region          = "us-east-1"
expected_account_id = "" # Replace with the confirmed deployment account.
project_name        = "hermes-lab"
instance_type       = "t3.medium"
ssh_cidr            = "" # Replace with your trusted public IPv4 /32.

# Choose one. An EC2 key pair must exist.
ssh_key_name = "your-existing-key-pair"
# ssh_public_key_path = "~/.ssh/hermes-lab.pub"

# Pin a reviewed Amazon Linux 2023 x86_64 image:
# ami_id = "ami-..."

# Explicit existing evidence resources, independent of their provisioner.
# The current executor reads input/, output/, and runs/ in this bucket.
evidence_bucket_name = "your-existing-evidence-bucket"
evidence_log_group   = "/your/existing/log-group"

# Optional agent report recipient; confirm the AWS subscription email.
# CloudWatch health and recovery emails are disabled.
# alert_email = "alerts@example.com"
