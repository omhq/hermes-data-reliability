aws_profile         = "default"
aws_region          = "us-east-1"
expected_account_id = "" # Replace with the confirmed deployment account.
instance_type       = "t3.medium"
ssh_cidr            = "" # Replace with your trusted public IP/CIDR.

# Choose one. An EC2 key pair must exist.
ssh_key_name = "your-existing-key-pair"
# ssh_public_key_path = "~/.ssh/hermes-lab.pub"

# After the first plan, pin its selected Amazon Linux 2023 x86_64 image:
# ami_id = "ami-..."

# Enable after the manual pipeline and investigation smoke tests:
pipeline_schedule_enabled = false
failure_probability       = 0.2

# Optional additional existing evidence resources (the lab is granted automatically):
# evidence_bucket_name = "your-lab-evidence-bucket"
# evidence_log_groups  = ["/aws/lambda/your-lab-loader"]

# Optional agent report recipient; confirm the AWS subscription email.
# CloudWatch health and recovery emails are disabled.
# alert_email = "alerts@example.com"
